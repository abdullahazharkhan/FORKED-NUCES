# Copy this to .env.local for local development
# On Vercel: add these as Environment Variables in the project settings

# ── Django Backend URL ────────────────────────────────────────────────────────
# May use HTTP when the backend is reached over a trusted private network.
# Browsers never call this URL directly; Next.js route handlers proxy requests to it.
# Example: http://backend.internal:8000

# Required in production. Next.js route handlers use this server-only URL.
# Local development may omit it and will fall back to http://localhost:8000.
DRF_API_BASE_URL=http://localhost:8000
