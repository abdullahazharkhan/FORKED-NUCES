# ── Database ──────────────────────────────────────────────
DB_NAME=forked_nuces
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# ── Django ────────────────────────────────────────────────
# Generate a secure key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-django-secret-key
ENVIRONMENT=development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Production HTTPS/security toggles. Set these to True only after HTTPS is configured.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
USE_WHITENOISE=False
# ── Frontend ──────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:3000
PASSWORD_RESET_TIMEOUT=3600

# ── Email ─────────────────────────────────────────────────
# Local dev: prints emails to console (no real email sent)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production Gmail SMTP (uncomment and set an App Password):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# ── CORS ──────────────────────────────────────────────────
# Add your frontend URL here
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ── Cache / rate limiting ─────────────────────────────────
# Leave blank for the in-process development cache. Production must use Redis.
REDIS_URL=

# ── Logging ───────────────────────────────────────────────
DJANGO_LOG_LEVEL=INFO
