# Copy this file to a secret path outside the repository (for example,
# /etc/forked-nuces/production.env), replace every placeholder, and pass it
# with `docker compose --env-file /etc/forked-nuces/production.env`.
COMPOSE_PROJECT_NAME=forked-nuces
IMAGE_TAG=production
ENVIRONMENT=production

DB_NAME=forked_nuces
DB_USER=forked_nuces
DB_PASSWORD=
SECRET_KEY=

DEBUG=False
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com
FRONTEND_BASE_URL=https://app.example.com
PASSWORD_RESET_TIMEOUT=3600

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
USE_WHITENOISE=True

# Public host port for Gunicorn. Restrict it to the trusted external TLS
# terminator/load balancer in production.
BACKEND_HOST_PORT=8000
REDIS_MAXMEMORY=128mb
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
DJANGO_LOG_LEVEL=INFO
